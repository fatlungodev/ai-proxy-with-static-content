# Server config
PORT=3005
HOST=0.0.0.0

# Your proxy API key (clients use this to authenticate with the proxy)
PROXY_API_KEY=sk-proxy-your-secret-key

# Upstream LLM backend.
# For OpenAI-shaped backends (OpenAI, Ollama, LM Studio, vLLM, OpenRouter,
#   Groq, Together, LocalAI, etc.) — use the backend's base URL.
# For Google Gemini — set UPSTREAM_PROVIDER=gemini below (URL auto-defaults
#   to https://generativelanguage.googleapis.com; the proxy translates
#   OpenAI ↔ Gemini protocols).
# Anthropic's native API is NOT OpenAI-shaped — use a gateway like LiteLLM.
UPSTREAM_BASE_URL=https://api.openai.com

# The real API key for the upstream provider
# For Gemini: your Google AI Studio API key (https://aistudio.google.com/apikey)
UPSTREAM_API_KEY=sk-your-real-api-key

# Provider type:
#   openai  → OpenAI-shaped passthrough (OpenAI, Ollama, vLLM, OpenRouter, Groq, ...)
#   gemini  → Google Gemini (proxy translates OpenAI ↔ Gemini)
UPSTREAM_PROVIDER=openai

# Default model to use when none is specified
# For Gemini try: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
DEFAULT_MODEL=gpt-4o

# Optional: comma-separated list of allowed models (leave blank to allow all)
ALLOWED_MODELS=

# Request timeout in milliseconds
REQUEST_TIMEOUT=120000

# Outbound HTTP proxy — used when this proxy must reach external LLMs
# through a corporate firewall. Standard env-var conventions apply.
# Examples:
#   HTTPS_PROXY=http://proxy.corp.local:8080
#   HTTPS_PROXY=http://user:pass@proxy.corp.local:8080
#   NO_PROXY=localhost,127.0.0.1,.internal.example
# Leave blank for direct connections.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Trust reverse proxy headers (X-Forwarded-For, X-Forwarded-Proto).
# Set to `true` if running behind nginx/cloudflare/etc, otherwise leave blank.
# Accepts: true | <number-of-hops> | <CIDR>. Empty = do not trust.
TRUST_PROXY=

# CORS — comma-separated allowed origins, or * to allow all
# Set to your n8n instance URL, e.g. http://localhost:5678
CORS_ORIGINS=*

# Local model list override for n8n's model dropdown.
# JSON array of model id strings. If set, /v1/models returns this list instead of calling upstream.
# Any incoming request whose `model` matches a name in this list is silently
# rewritten to DEFAULT_MODEL before being forwarded upstream — so apps can pick
# a friendly alias from the dropdown without the upstream rejecting it.
# Example: ["LOCAL_MODELS","my-llm"]
LOCAL_MODELS=

# Dashboard config — REQUIRED when HOST is non-loopback.
# The proxy will refuse to start if it would publicly expose an open dashboard
# (HOST=0.0.0.0 with no DASHBOARD_PASSWORD/DASHBOARD_TOKEN). Override with
# DASHBOARD_OPEN=true at your own risk.
DASHBOARD_PASSWORD=

# Optional bearer token for programmatic / API-client access to dashboard endpoints.
# When set, open dashboard with: http://host:port/?token=YOUR_TOKEN
DASHBOARD_TOKEN=

# Force the dashboard session cookie to include `Secure` even when the proxy
# can't auto-detect HTTPS (e.g. behind a TLS-terminating reverse proxy with
# no X-Forwarded-Proto). Recommended in production.
DASHBOARD_FORCE_SECURE_COOKIE=

# Dashboard session lifetime in seconds (default 7 days).
DASHBOARD_SESSION_MAX_AGE=604800

# Max number of request log entries kept in memory (ring buffer)
LOG_BUFFER_SIZE=500

# Persistent log file size cap before rotation to *.1 (default 100 MB)
LOG_FILE_MAX_BYTES=104857600

# Request/response body capture: off | snippet | full (default: snippet, 2 KB)
# Sensitive keys (authorization, password, api_key, token, ...) are always redacted.
LOG_CAPTURE_BODIES=snippet

# Max upstream response body for non-stream JSON paths (default 50 MB)
UPSTREAM_MAX_RESPONSE_BYTES=52428800

# Silence the startup warning when UPSTREAM_BASE_URL points at a private/loopback
# host (e.g. Ollama at http://localhost:11434).
ALLOW_PRIVATE_UPSTREAM=
